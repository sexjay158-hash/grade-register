{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-local.mjs dev",
    "preview:internet": "node scripts/temporary-internet-preview.mjs",
    "preview:stop": "node scripts/temporary-internet-preview.mjs stop",
    "rapidocr": "node scripts/run-local.mjs rapidocr",
    "verify:roles": "node scripts/verify-roles.mjs",
    "verify:load": "node scripts/verify-load.mjs",
    "verify:burst": "node scripts/verify-burst.mjs",
    "build": "node scripts/run-framework.mjs build",
    "start": "node scripts/start-local.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "node scripts/check.mjs",
    "check:quick": "node scripts/check.mjs --quick",
    "verify:races": "node scripts/verify-roles.mjs --races",
    "data:backup": "node scripts/data-backup.mjs create",
    "data:verify": "node scripts/data-backup.mjs verify",
    "data:restore": "node scripts/data-backup.mjs restore",
    "verify:group-accounts": "node scripts/verify-roles.mjs --group-accounts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "^1.24.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "^8.1.6",
    "wrangler": "^4.151.3"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "vinext": {
      "image-size": "2.0.4"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "3.3.3"
    }
  }
}
